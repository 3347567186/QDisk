  "program_runtime_threshold": 3,
  "_app_guard": "程序安装目录保护：命中即整目录不动——不整理、不搬走、不合并进别的目录、不清空。这是硬规则，不受「允许整理盘符根目录」影响",
  "protect_app_dirs": true,
  "app_dir_uninstallers": [
    "unins000.exe",
    "unins001.exe",
    "unins002.exe",
    "uninstall.exe",
    "uninst.exe",
    "uninst000.exe",
    "unins000.dat",
    "uninstall.dat"
  ],
